# ─────────────────────────────────────────────────────────────────────
#  Miyomi environment template.
#
#  ONE PLACE RULE (see DEVELOPERS.md → "Configuration"):
#    • All NON-SECRET config lives in `wrangler.toml` → `[vars]`.
#      The frontend build and the OG generator read those values from
#      wrangler.toml, not from this file.
#    • All SECRETS are set via Cloudflare, never in a file:
#          npx wrangler secret put <NAME>           # production
#          npx wrangler secret put --local <NAME>   # local dev (→ .dev.vars)
#
#  This `.env` file is ONLY for local developer tooling, not runtime.
#  NEVER commit it or put real secrets here.
#  Secrets in use: SESSION_SECRET, TURNSTILE_SECRET_KEY, CF_API_TOKEN,
#  TELEGRAM_BOT_TOKEN (admin notifications), optional CDN_API_KEY.
#  Global Telegram chat ids are NON-secret: wrangler.toml [vars] → TELEGRAM_CHAT_IDS.
# ─────────────────────────────────────────────────────────────────────

# ── Local developer tooling only ────────────────────────────────────
# Drizzle Kit (db:studio / db:push) talks to D1 over the HTTP API using
# these. Not needed to build, run, or deploy.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_TOKEN=""

# ── Optional build-time overrides ────────────────────────────────────
# Rarely needed. Defaults come from wrangler.toml [vars].
#   OG_API_URL      — base URL whose /api serves content (default: SITE_URL)
#   SKIP_OG_IMAGES  — "true" to skip OG generation (development)
OG_API_URL=""
SKIP_OG_IMAGES=""